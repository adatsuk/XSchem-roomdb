# Minimal rc for LibMan batch netlist (no script prompt).
# Includes stock devices + IHP PDK so hierarchical cells (sg13_lv_*) resolve.
set xschem_execute_scripts yes

set share [file join $env(HOME) .local share xschem]
if {[file exists [file join $share xschemrc]]} {
  source [file join $share xschemrc]
}

# Ensure devices library is present even if share rc was empty.
if {![info exists XSCHEM_LIBRARY_PATH]} {
  set XSCHEM_LIBRARY_PATH {}
}
if {[file isdirectory [file join $share xschem_library]]} {
  append XSCHEM_LIBRARY_PATH :[file join $share xschem_library]
  append XSCHEM_LIBRARY_PATH :[file join $share xschem_library devices]
}

# IHP Open PDK transistor symbols (sg13g2_pr/sg13_lv_nmos.sym etc.)
if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq ""} {
  foreach pdk {
    /mnt/c/Work/IHP
    [file join $env(HOME) IHP-Open-PDK]
    /mnt/c/Users/anton/Documents/IHP-Open-PDK
  } {
    if {[file isdirectory [file join $pdk ihp-sg13g2]]} {
      set env(PDK_ROOT) $pdk
      break
    }
  }
}
if {![info exists env(PDK)] || $env(PDK) eq ""} {
  set env(PDK) ihp-sg13g2
}
if {[info exists env(PDK_ROOT)] && $env(PDK_ROOT) ne ""} {
  set pdk_xschem [file join $env(PDK_ROOT) $env(PDK) libs.tech xschem]
  # Parent of sg13g2_pr so references like sg13g2_pr/sg13_lv_nmos.sym resolve.
  if {[file isdirectory $pdk_xschem]} {
    append XSCHEM_LIBRARY_PATH :$pdk_xschem
  }
}

# LibMan CORE primitives (analogLib controllers, cached PDK cells).
set prim_cache [file join $env(HOME) .cache libman-xschem primitives]
if {[info exists env(XSCHEM_PRIMITIVE_CACHE)] && $env(XSCHEM_PRIMITIVE_CACHE) ne ""} {
  set prim_cache $env(XSCHEM_PRIMITIVE_CACHE)
}
if {[file isdirectory $prim_cache]} {
  append XSCHEM_LIBRARY_PATH :$prim_cache
}
set script_dir [file dirname [info script]]
set repo_cache [file join $script_dir primitive_cache]
if {[file isdirectory $repo_cache]} {
  append XSCHEM_LIBRARY_PATH :$repo_cache
}
set xschem_root [file normalize [file join $script_dir ..]]
if {[file isdirectory [file join $xschem_root xschem-src xschem_library]]} {
  append XSCHEM_LIBRARY_PATH :[file join $xschem_root xschem-src xschem_library]
  append XSCHEM_LIBRARY_PATH :[file join $xschem_root xschem-src xschem_library devices]
}
