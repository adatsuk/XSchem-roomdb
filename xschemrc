# Xschem workspace config with CORE in-process integration

# LibMan/WSL: ignore corrupted per-file sizes in ~/.xschem/geometry (e.g. 1x1)
set initial_geometry {1300x950}

# CORE is authoritative; payload/*.sch is Xschem editor cache (export on open, import on save).

set ::XSCHEM_ROOT [file normalize [file dirname [info script]]]

if {[info exists ::env(COMMONDB_ROOT)] && $::env(COMMONDB_ROOT) ne ""} {
  set ::CORE_ROOT [file normalize $::env(COMMONDB_ROOT)]
} elseif {[info exists ::env(CORE_ROOT)] && $::env(CORE_ROOT) ne ""} {
  set ::CORE_ROOT [file normalize $::env(CORE_ROOT)]
} else {
  set ::CORE_ROOT [file normalize [file join $::XSCHEM_ROOT .. CommonDB]]
}

set ::core_payload_dir [file join $::CORE_ROOT designs xschem payload]

set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :$::core_payload_dir
append XSCHEM_LIBRARY_PATH :[file join $::XSCHEM_ROOT integrations qucs_symbols]
# Schematics reference devices/lab_pin.sym — library root must be xschem_library/
# (not the devices/ subdir alone, or devices/devices/lab_pin.sym is searched).
foreach lib {
  [file join $env(HOME) .local share xschem xschem_library]
  [file join $::XSCHEM_ROOT xschem-src xschem_library]
} {
  if {[file isdirectory $lib]} {
    append XSCHEM_LIBRARY_PATH :$lib
    append XSCHEM_LIBRARY_PATH :[file join $lib devices]
  }
}
append XSCHEM_LIBRARY_PATH :$env(HOME)/.local/share/doc/xschem/examples

# IHP Open PDK (sg13g2_pr/sg13_lv_nmos.sym etc.) — required for hierarchical netlist.
if {![info exists ::env(PDK_ROOT)] || $::env(PDK_ROOT) eq ""} {
  foreach pdk {
    /mnt/c/Work/IHP
    [file join $env(HOME) IHP-Open-PDK]
    /mnt/c/Users/anton/Documents/IHP-Open-PDK
  } {
    if {[file isdirectory [file join $pdk ihp-sg13g2]]} {
      set ::env(PDK_ROOT) $pdk
      break
    }
  }
}
if {![info exists ::env(PDK)] || $::env(PDK) eq ""} {
  set ::env(PDK) ihp-sg13g2
}
if {[info exists ::env(PDK_ROOT)] && $::env(PDK_ROOT) ne ""} {
  set pdk_xschem [file join $::env(PDK_ROOT) $::env(PDK) libs.tech xschem]
  # Parent of sg13g2_pr so references like sg13g2_pr/sg13_lv_nmos.sym resolve.
  if {[file isdirectory $pdk_xschem]} {
    append XSCHEM_LIBRARY_PATH :$pdk_xschem
  }
}

# LibMan tech primitives land here (open-xschem-wsl.sh sets XSCHEM_PRIMITIVE_CACHE per session).
set ::core_primitive_cache [file join $::XSCHEM_ROOT integrations primitive_cache]
if {[info exists ::env(XSCHEM_PRIMITIVE_CACHE)] && $::env(XSCHEM_PRIMITIVE_CACHE) ne ""} {
  catch {set ::core_primitive_cache [file normalize $::env(XSCHEM_PRIMITIVE_CACHE)]}
}
catch {file mkdir $::core_primitive_cache}
append XSCHEM_LIBRARY_PATH :$::core_primitive_cache

# LibMan CORE files are trusted project data; avoid modal script prompt blocking startup.
set xschem_execute_scripts yes

# Default Xschem uses gvim; WSL images often lack it — prefer vim/nano if available.
if {[catch {exec which vim}]} {
  if {![catch {exec which nano}]} {
    set editor {nano}
  }
} else {
  set editor {vim -f}
}

set netlist_dir $::core_payload_dir
if {[info exists ::env(XSCHEM_NETLIST_DIR)] && $::env(XSCHEM_NETLIST_DIR) ne ""} {
  catch {file mkdir $::env(XSCHEM_NETLIST_DIR)}
  set netlist_dir $::env(XSCHEM_NETLIST_DIR)
}

# WSL/LibMan: ngspice batch by default (interactive xterm breaks on WSLg screen geometry).
proc libman_configure_ngspice {} {
  global sim
  if {![info exists sim(spice,default)]} {
    after 300 libman_configure_ngspice
    return
  }
  if {([info exists ::env(WSL_DISTRO_NAME)] && $::env(WSL_DISTRO_NAME) ne "")
      || ([info exists ::env(XSCHEM_NETLIST_DIR)] && $::env(XSCHEM_NETLIST_DIR) ne "")} {
    set sim(spice,default) 2
    set sim(spice,2,cmd) {ngspice -b "$N"}
    set sim(spice,2,fg) 0
    set sim(spice,2,st) 0
  }
}
after idle libman_configure_ngspice

source [file join $::XSCHEM_ROOT integrations core.tcl]
